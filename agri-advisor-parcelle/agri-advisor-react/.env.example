# URL of the FastAPI backend (uvicorn main:app --reload).
# Copy this file to .env and adjust if your backend runs elsewhere.
VITE_API_BASE_URL=http://127.0.0.1:8000

# URL of the main "AgriGuide" app (frontend/). The sidebar's Accueil/Règles/Budget/
# Aujourd'hui/Marché items link back here. Defaults to the local dev server if unset.
VITE_AGRIGUIDE_URL=http://localhost:8080
