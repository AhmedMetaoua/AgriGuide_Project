# Copy this file to .env and fill in your keys.
# Never commit your real .env file.

# ------------------------------------------------------------------
# LLM (required)
# ------------------------------------------------------------------
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest
LLM_PROVIDER=mistral
LLM_TEMPERATURE=0.0

# Rate limiting. A research pass makes LLM calls in bursts, so free Mistral
# tiers hit their quota easily. On a 429 the agent backs the WHOLE pipeline
# off (15s, 30s, 60s, 120s) rather than retrying quickly, because a rate
# limit needs its quota window to reopen.
LLM_MIN_REQUEST_INTERVAL=2.0
LLM_MAX_PARALLEL_EXTRACTIONS=2
LLM_MAX_RETRIES=5

# Batching is what fixes the 429s WITHOUT analysing fewer sources:
# 29 sources at batch size 6 is 6 LLM calls instead of 30. Every source is
# still analysed. The character budget shrinks batches automatically when
# full-text retrieval is on, so prompts stay within context.
# Set EXTRACTION_BATCH_SIZE=1 to extract one source per call: slower, but
# the model's attention isn't split across passages.
EXTRACTION_BATCH_SIZE=6
EXTRACTION_BATCH_MAX_CHARS=24000
# Sources with less text than this are skipped without an LLM call.
EXTRACTION_MIN_SOURCE_CHARS=200

# ------------------------------------------------------------------
# General web search (required for autonomous research)
# Choose ONE provider and set WEB_SEARCH_PROVIDER accordingly.
# ------------------------------------------------------------------
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
# SERPER_API_KEY=your_serper_api_key_here

# ------------------------------------------------------------------
# Academic search (optional keys — both APIs work without one,
# but providing them raises rate limits)
# ------------------------------------------------------------------
# SEMANTIC_SCHOLAR_API_KEY=your_key_here
CROSSREF_MAILTO=your_email@example.com

# ------------------------------------------------------------------
# Embeddings / vector store (Qdrant Cloud)
# Create a free cluster at https://cloud.qdrant.io, then copy its
# cluster URL and generate an API key from the cluster's "API Keys" tab.
# ------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
QDRANT_URL=https://xxxxxxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=agri_waste_knowledge

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
LOG_LEVEL=INFO
APP_ENV=development

# ------------------------------------------------------------------
# Observability (optional)
# ------------------------------------------------------------------
# Traces every step of the pipeline to LangSmith: query planning, each
# search, each extraction, validator rejections, and every LLM call with
# its retries. Useful for answering "why did this crop return nothing?".
# Get a free key at https://smith.langchain.com (Settings -> API Keys).
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=agri-waste-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region only
